# Sin credenciales reales. Cloud y grupos desactivados de forma predeterminada.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
PUBLIC_ORIGIN=http://127.0.0.1:3000
DB_PATH=data/clickcut.sqlite
CLOUD_ENABLED=false
META_APP_SECRET=
META_VERIFY_TOKEN=
META_PHONE_NUMBER_ID=
META_ACCESS_TOKEN=
# Seleccionar una versión Graph soportada antes de habilitar Cloud.
META_GRAPH_VERSION=
# nombre:idioma de plantillas aprobadas SIN parámetros; separados por coma.
META_APPROVED_TEMPLATES=
GROUPS_ENABLED=false
GROUPS_RISK_ACCEPTED=false
GROUPS_CONFIG=groups/config.local.json
GROUPS_DB_PATH=data/groups.sqlite
GROUPS_AUTH_DIR=groups/auth
# Solo para vinculación local posterior; nunca activar en logs de producción.
GROUPS_PAIRING_LOCAL=false
